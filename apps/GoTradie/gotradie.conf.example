# GoTradie configuration.
# Values in this file override environment variables.

INVOICE_NINJA_URL=https://your.invoice-ninja.example
INVOICE_NINJA_TOKEN=

BUNNINGS_ENV=live
BUNNINGS_CLIENT_ID=
BUNNINGS_CLIENT_SECRET=
BUNNINGS_COUNTRY=AU
BUNNINGS_LOCATION=
BUNNINGS_SCOPES=

PRODUCT_PREFIX=BUNNINGS-
BUNNINGS_IN_CUSTOM_FIELD=1
BUNNINGS_IMAGE_CUSTOM_FIELD=2
TAX_NAME=GST
TAX_RATE=10

# Required by: GoTradie ninja export erpnext <directory>
# Values must exactly match records already configured in ERPNext.
ERPNEXT_COMPANY=
ERPNEXT_CUSTOMER_GROUP=
ERPNEXT_TERRITORY=
ERPNEXT_ITEM_GROUP=
ERPNEXT_UOM=Nos
ERPNEXT_SELLING_PRICE_LIST=Standard Selling
ERPNEXT_CURRENCY=AUD
ERPNEXT_COUNTRY=Australia
ERPNEXT_INCOME_ACCOUNT=
ERPNEXT_RECEIVABLE_ACCOUNT=
ERPNEXT_BANK_ACCOUNT=
ERPNEXT_MODE_OF_PAYMENT=
# Optional. Required for correct totals when taxed documents are present.
ERPNEXT_TAX_TEMPLATE=
